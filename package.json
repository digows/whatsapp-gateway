{
  "name": "whatsapp-gateway",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=development --import tsx --test --test-concurrency=1 runtime/test/*.test.ts packages/chat-adapter/test/*.test.ts",
    "format": "dprint fmt --config dprint.json",
    "format:check": "dprint check --config dprint.json",
    "check": "pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "build": "node scripts/build.mjs",
    "start": "node runtime/dist/cli.js",
    "migrate": "node runtime/dist/cli.js migrate"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@asyncapi/parser": "3.6.6",
    "@chat-adapter/state-memory": "4.43.0",
    "@chat-adapter/state-redis": "4.43.0",
    "@mastra/core": "1.79.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "dprint": "0.57.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
